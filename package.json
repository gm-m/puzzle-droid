{
  "name": "chess-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "build:gh-pages": "ng build --configuration production --base-href /puzzle-droid/",
    "build:web": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "node --env-file=.env.test ./node_modules/@angular/cli/bin/ng.js test",
    "test:ci": "npm test -- --watch=false",
    "e2e": "npm run build -- --configuration development && vitest run --config vitest.e2e.config.ts",
    "e2e:headed": "npm run e2e -- --mode headed",
    "e2e:debug": "npm run e2e -- --mode debug",
    "android:add": "npx cap add android",
    "cap:sync": "npx cap sync android",
    "android:open": "npx cap open android",
    "android": "npm run build:web && npm run cap:sync && npm run android:open"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "dependencies": {
    "@angular/common": "^20.2.0",
    "@angular/compiler": "^20.2.0",
    "@angular/core": "^20.2.0",
    "@angular/forms": "^20.2.0",
    "@angular/platform-browser": "^20.2.0",
    "@angular/router": "^20.2.0",
    "@capacitor/android": "^8.1.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/haptics": "^8.0.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "chess.js": "^1.4.0",
    "chessground": "^9.2.1",
    "rxjs": "~7.8.0",
    "stockfish": "^17.1.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^20.2.2",
    "@angular/cli": "^20.2.2",
    "@angular/compiler-cli": "^20.2.0",
    "@vitest/coverage-v8": "~3.2.6",
    "fake-indexeddb": "^6.2.0",
    "jsdom": "^26.1.0",
    "playwright": "1.58.2",
    "typescript": "~5.9.2",
    "vite": "^7.1.11",
    "vitest": "~3.2.6"
  }
}
